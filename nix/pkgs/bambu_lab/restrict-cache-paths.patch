+            printer_cache_path = Path(coordinator.get_file_cache_directory()).resolve()
+            base_cache_path = printer_cache_path.parent
+            if not isinstance(cache_path, str):
+                return web.json_response({"error": "Invalid cache path"}, status=400)
+            relative_path = Path(cache_path)
+            if (relative_path.is_absolute() or ".." in relative_path.parts
+                    or len(relative_path.parts) < 3 or relative_path.parts[1] != "prints"):
+                return web.json_response({"error": "Invalid cache path"}, status=400)
+
+            # Allow cross-printer uploads, but neither reads nor writes outside the cache.
+            local_path = (base_cache_path / relative_path).resolve()
+            print_path = Path(*relative_path.parts[2:])
+            destination_path = (printer_cache_path / "prints" / print_path).resolve()
+            try:
+                local_path.relative_to(base_cache_path)
+                destination_path.relative_to(printer_cache_path)
+            except ValueError:
+                return web.json_response({"error": "Access denied"}, status=403)
+            local_path = str(local_path)
